<!--
  SCAFFOLD — issue gus-live-agentforce-provider-auth.
  Secret-free by design (CLAUDE.md §4, gus-chat-provider-settings.md §2):
  the OAuth consumer secret is entered directly against this External
  Credential's Principal in gtm-staging Setup, never in this file.

  PLACEHOLDER markers below must be replaced once the coordinator returns
  live facts from the External Client App wizard (see the click-list in
  this issue's handback). Do not deploy until every PLACEHOLDER is
  resolved and the addendum in docs/architecture/gus-chat-provider-settings.md
  §5 confirms the values live.

  ALSO UNVERIFIED: the element names below (oauthConfig, parameters, etc.)
  are drafted from memory of the ExternalCredential Metadata API shape and
  have NOT been checked against a live `sf project retrieve` of a real
  External Credential in gtm-staging, nor against current Salesforce
  Metadata API reference docs. Before this file is ever deployed, retrieve
  the actual metadata Setup generates for the External Credential created
  per this issue's click-list and reconcile field-for-field — do not trust
  this shell's tag names as deploy-ready.
-->
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>OAuth</authenticationProtocol>
    <label>GTM Agentforce Credential</label>
    <namedCredentialType>ExternalCredential</namedCredentialType>
    <oauthConfig>
        <PLACEHOLDER_oauthClientCredentialsPolicy>true</PLACEHOLDER_oauthClientCredentialsPolicy>
        <PLACEHOLDER_scope>sfap_api api</PLACEHOLDER_scope>
        <!--
          PLACEHOLDER: consumerKey below is not a secret (it's the client
          ID), but it is still an org-specific value only known once the
          External Client App is created live. Fill from the coordinator's
          reported consumer key. The consumer SECRET is never added here —
          it is entered as the Principal's "Client Secret" field directly
          in gtm-staging Setup > External Credentials > GTM_Agentforce_Credential
          > Principals > (Principal) > Authentication Parameters.
        -->
        <PLACEHOLDER_consumerKey>PLACEHOLDER-FILL-AFTER-ECA-CREATED</PLACEHOLDER_consumerKey>
    </oauthConfig>
    <parameters>
        <!-- Principal: client-credentials flow uses a "Named Principal", not per-user -->
        <parameterName>PLACEHOLDER_GTM_Agentforce_Principal</parameterName>
        <parameterType>Authentication</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </parameters>
</ExternalCredential>
