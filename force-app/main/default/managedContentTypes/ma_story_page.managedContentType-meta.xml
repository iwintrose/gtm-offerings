<?xml version="1.0" encoding="UTF-8"?>
<ManagedContentType xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>The hero headline/subhead and proof-panel numbers on a GTM Offering&apos;s internal "story" pitch page (maStory). One record per offering.</description>
    <developerName>ma_story_page</developerName>
    <managedContentNodeTypes>
        <isLocalizable>true</isLocalizable>
        <isRequired>true</isRequired>
        <nodeLabel>Content Title</nodeLabel>
        <nodeName>title</nodeName>
        <nodeType>NAMEFIELD</nodeType>
    </managedContentNodeTypes>
    <managedContentNodeTypes>
        <helpText>Matches MA_Offering__mdt.Offering_Key__c, e.g. migration-accelerator.</helpText>
        <isLocalizable>false</isLocalizable>
        <isRequired>true</isRequired>
        <nodeLabel>Offering Key</nodeLabel>
        <nodeName>offeringKey</nodeName>
        <nodeType>TEXT</nodeType>
    </managedContentNodeTypes>
    <managedContentNodeTypes>
        <helpText>The page's main headline. Note: any custom color-accent styling on part of the old hardcoded headline does not carry over here -- bold/italic/links are supported, a custom highlight color is not.</helpText>
        <isLocalizable>true</isLocalizable>
        <isRequired>false</isRequired>
        <nodeLabel>Hero Headline</nodeLabel>
        <nodeName>heroHeadline</nodeName>
        <nodeType>RTE</nodeType>
    </managedContentNodeTypes>
    <managedContentNodeTypes>
        <isLocalizable>true</isLocalizable>
        <isRequired>false</isRequired>
        <nodeLabel>Hero Subhead</nodeLabel>
        <nodeName>heroSubhead</nodeName>
        <nodeType>RTE</nodeType>
    </managedContentNodeTypes>
    <managedContentNodeTypes>
        <helpText>The "objects mapped" number in the proof panel, e.g. 1284</helpText>
        <isLocalizable>false</isLocalizable>
        <isRequired>false</isRequired>
        <nodeLabel>Proof: Objects Mapped</nodeLabel>
        <nodeName>proofObjectsCount</nodeName>
        <nodeType>TEXT</nodeType>
    </managedContentNodeTypes>
    <managedContentNodeTypes>
        <helpText>The "dependencies traced" number in the proof panel, e.g. 3140</helpText>
        <isLocalizable>false</isLocalizable>
        <isRequired>false</isRequired>
        <nodeLabel>Proof: Dependencies Traced</nodeLabel>
        <nodeName>proofDepsCount</nodeName>
        <nodeType>TEXT</nodeType>
    </managedContentNodeTypes>
    <managedContentNodeTypes>
        <helpText>The health-score gauge in the proof panel, 0-100, e.g. 84</helpText>
        <isLocalizable>false</isLocalizable>
        <isRequired>false</isRequired>
        <nodeLabel>Proof: Health Score</nodeLabel>
        <nodeName>proofHealthScore</nodeName>
        <nodeType>TEXT</nodeType>
    </managedContentNodeTypes>
    <masterLabel>MA Story Page</masterLabel>
</ManagedContentType>
