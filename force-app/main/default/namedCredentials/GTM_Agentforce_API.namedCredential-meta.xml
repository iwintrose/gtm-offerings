<?xml version="1.0" encoding="UTF-8"?>
<!--
  SCAFFOLD — issue gus-live-agentforce-provider-auth. Same caveats as
  GTM_Agentforce_Credential.externalCredential-meta.xml in the sibling
  directory: element names are drafted from memory, NOT verified against
  a live retrieve or current Metadata API docs, and the endpoint URL below
  is a PLACEHOLDER until the coordinator reports the actual gtm-staging
  My Domain URL used when the agent/ECA is created. Reconcile against a
  real retrieve before deploying.

  Design note: GTM_Agent_Settings__c.Agentforce_My_Domain_URL__c already
  stores the org's My Domain URL for display/admin purposes, but a Named
  Credential's endpoint is a static metadata value, not read dynamically
  from a custom setting at callout time. If the runtime issue needs the
  endpoint to vary without a redeploy, that's a decision for the
  `gus-live-agentforce-provider-runtime` issue (e.g. building the HTTP
  request in Apex against $Credential-based auth only, with the path
  assembled from GTM_Agent_Settings__c) — not something to solve here.
-->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>GTM Agentforce API</label>
    <namedCredentialType>SecuredEndpoint</namedCredentialType>
    <namedCredentialParameters>
        <parameterName>Url</parameterName>
        <parameterType>Url</parameterType>
        <!-- PLACEHOLDER: replace with the real gtm-staging My Domain URL,
             e.g. https://<staging-domain>.my.salesforce.com -->
        <parameterValue>https://PLACEHOLDER-STAGING-MY-DOMAIN.my.salesforce.com</parameterValue>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <parameterName>ExternalCredential</parameterName>
        <parameterType>Authentication</parameterType>
        <parameterValue>GTM_Agentforce_Credential</parameterValue>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <parameterName>GenerateAuthorizationHeader</parameterName>
        <parameterType>GenerateAuthorizationHeader</parameterType>
        <parameterValue>true</parameterValue>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <parameterName>AllowMergeFieldsInBody</parameterName>
        <parameterType>AllowMergeFieldsInBody</parameterType>
        <parameterValue>false</parameterValue>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <parameterName>AllowMergeFieldsInHeader</parameterName>
        <parameterType>AllowMergeFieldsInHeader</parameterType>
        <parameterValue>false</parameterValue>
    </namedCredentialParameters>
</NamedCredential>
