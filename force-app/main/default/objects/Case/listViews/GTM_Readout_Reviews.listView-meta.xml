<?xml version="1.0" encoding="UTF-8"?>
<ListView xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GTM_Readout_Reviews</fullName>
    <!-- The native half of the rep queue. Every readout now has a Case, so the
         standard Case list view gives filtering, sorting, inline edit, mass
         owner change and the "accept from queue" action for free — none of
         which the custom card list (c/gtmReadoutsOverview) has or should grow.
         The custom list stays for the offering's visual identity and its
         deep-link into the editor; see docs/runbooks/readout-public-link.md. -->
    <filterScope>Everything</filterScope>
    <filters>
        <field>Readout__c</field>
        <operation>notEqual</operation>
        <value></value>
    </filters>
    <label>Readout Reviews</label>
    <columns>CASES.CASE_NUMBER</columns>
    <columns>CASES.SUBJECT</columns>
    <columns>CASES.STATUS</columns>
    <columns>CORE.USERS.ALIAS</columns>
    <columns>Readout__c</columns>
    <columns>CASES.CREATED_DATE</columns>
    <columns>CASES.LAST_UPDATE</columns>
</ListView>
