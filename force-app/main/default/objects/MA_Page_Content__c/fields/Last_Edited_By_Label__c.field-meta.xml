<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Last_Edited_By_Label__c</fullName>
    <label>Last Edited By</label>
    <description>Display formula showing who last modified this record and when, for the Manager app content list.</description>
    <type>Formula</type>
    <formula>LastModifiedBy.Name &amp; ' · ' &amp; TEXT(DAY(LastModifiedDate)) &amp; '/' &amp; TEXT(MONTH(LastModifiedDate)) &amp; '/' &amp; TEXT(YEAR(LastModifiedDate))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <returnType>Text</returnType>
</CustomField>
