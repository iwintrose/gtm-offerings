<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Guest access, one narrow class at a time: Apex access is per class, not per method. GtmFormDraftController is the only write - one bearer-token-addressed draft of what the visitor typed, on an active link, reading nothing else back.</description>
    <label>GTM Story Guest</label>
    <classAccesses>
        <apexClass>GtmPageContentReader</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>GtmViewerContext</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>GtmConfigurationReader</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>GtmFormDraftController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!-- SECURITY-REVIEW NOTE (docs/handoff/port-map-ma-to-gtm.md section E):
         GTM_Form_Draft__c is now a SHARED object - it also holds the
         branching readiness-questionnaire draft (Draft_Type__c =
         'Assessment', a separate guest population under GTM_Assessment_Guest,
         accessed only through GtmAssessmentDraftController's class grant,
         never through an object/field permission). This grant's object
         permission and the 3 field permissions below are intentionally
         narrow and must stay that way:
           - never add viewAllRecords;
           - never add a field permission on Resume_Token__c, Expires_At__c,
             Status__c, Submitted_Request__c, Pair_Key__c, Last_Saved_At__c,
             or Draft_Type__c;
           - GtmFormDraftController itself filters every query and insert to
             Draft_Type__c = 'Booking', which is what actually keeps this
             population from ever reading or writing an Assessment row, but
             that control is defense in depth on top of this permission set
             staying narrow, not a substitute for it. -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>GTM_Form_Draft__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <editable>true</editable><field>GTM_Form_Draft__c.Draft_JSON__c</field><readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable><field>GTM_Form_Draft__c.Furthest_Field__c</field><readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable><field>GTM_Form_Draft__c.Session_Id__c</field><readable>true</readable>
    </fieldPermissions>
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>GTM_Offering__mdt</name>
    </customMetadataTypeAccesses>
</PermissionSet>
