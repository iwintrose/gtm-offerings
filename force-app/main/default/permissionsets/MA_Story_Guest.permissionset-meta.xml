<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Read-only guest access to CMS-backed story content (MaStoryContentController). Separate from MA_Assessment_Guest so a story-only guest user doesn't pick up its booking-flow create rights.</description>
    <label>MA Story Guest</label>
    <classAccesses>
        <apexClass>MaStoryContentController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>MA_Offering__mdt</name>
    </customMetadataTypeAccesses>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>MA_CMS_Content_Index__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>MA_CMS_Content_Index__c.Display_Order__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>MA_CMS_Content_Index__c.Active__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
</PermissionSet>
